{
  "name": "@arcanewizards/talisman-arcade-desktop",
  "productName": "Talisman MIDI Arcade Desktop",
  "description": "Test MIDI controllers for use with Arcane software",
  "author": "Arcane Wizards Ltd.",
  "version": "0.0.1",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --max-warnings 0 --fix",
    "check:types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "build": "pnpm check:types && pnpm clean && pnpm build:main && pnpm build:preload && pnpm build:frontend",
    "build:workspace": "pnpm -r --filter @arcanewizards/talisman-arcade-desktop... build",
    "build:main": "esbuild --define:process.env.NODE_ENV=\\\"production\\\" src/main.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --external:@arcanewizards/electron-media-service --external:@arcanewizards/midi --external:@arcanewizards/net-utils-native --outfile=dist/main.js",
    "build:preload": "esbuild --define:process.env.NODE_ENV=\\\"production\\\" src/preload.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --outfile=dist/preload.js",
    "build:frontend": "esbuild --define:process.env.NODE_ENV=\\\"production\\\" src/frontend.ts --bundle --platform=browser --format=iife --conditions=@arcanewizards/talisman-source --outfile=dist/frontend.js",
    "start": "pnpm build && electron-forge start",
    "package": "pnpm build && electron-forge package",
    "make": "pnpm build && electron-forge make",
    "version-sync": "jq -r '.version' ../talisman-arcade/package.json | xargs -I {} jq --arg version {} '.version = $version' package.json > package.new.json && mv package.new.json package.json && cp ../talisman-arcade/CHANGELOG.md ./CHANGELOG.md"
  },
  "dependencies": {
    "@arcanewizards/midi": "^0.1.3",
    "bindings": "^1.5.0",
    "file-uri-to-path": "^1.0.0",
    "material-symbols": "^0.25.3",
    "nan": "^2.26.2",
    "semver": "^5.7.2"
  },
  "devDependencies": {
    "@arcanewizards/talisman-eslint-config": "workspace:^",
    "@arcanewizards/talisman-arcade": "workspace:^",
    "@arcanewizards/sigil": "^0.6.0",
    "@arcanewizards/sigil-assets": "^0.1.1",
    "@arcanewizards/talisman-typescript-config": "workspace:^",
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron/rebuild": "^4.0.4",
    "electron": "^41.5.2",
    "electron-squirrel-startup": "^1.0.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.4",
    "pino": "^9.14.0",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
