{
  "name": "@talisman-midi/profiles",
  "version": "0.0.3",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "@talisman-midi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup && check-export-map",
    "check:types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:private": "pnpm lint",
    "lint:fix": "eslint --fix .",
    "test": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --coverage"
  },
  "devDependencies": {
    "@talisman-midi/eslint-config": "workspace:^",
    "@talisman-midi/typescript-config": "workspace:^",
    "@jest/globals": "^30.1.2",
    "check-export-map": "^1.3.1",
    "eslint": "^9.39.4",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "tsup": "^8.1.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@talisman-midi/talisman": "workspace:^",
    "zod": "^3.25.76"
  }
}
