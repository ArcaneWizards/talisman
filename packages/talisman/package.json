{
  "name": "@talisman-midi/talisman",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "@talisman-midi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./color": {
      "@talisman-midi/source": "./src/color.ts",
      "types": "./dist/color.d.ts",
      "import": "./dist/color.js",
      "require": "./dist/color.cjs"
    },
    "./core": {
      "@talisman-midi/source": "./src/core.ts",
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./feedback": {
      "@talisman-midi/source": "./src/feedback.ts",
      "types": "./dist/feedback.d.ts",
      "import": "./dist/feedback.js",
      "require": "./dist/feedback.cjs"
    },
    "./profile": {
      "@talisman-midi/source": "./src/profile.ts",
      "types": "./dist/profile.d.ts",
      "import": "./dist/profile.js",
      "require": "./dist/profile.cjs"
    },
    "./util": {
      "@talisman-midi/source": "./src/util.ts",
      "types": "./dist/util.d.ts",
      "import": "./dist/util.js",
      "require": "./dist/util.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup && check-export-map",
    "check:types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:private": "pnpm lint",
    "lint:fix": "eslint --fix .",
    "test": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --coverage"
  },
  "devDependencies": {
    "@talisman-midi/eslint-config": "workspace:^",
    "@talisman-midi/typescript-config": "workspace:^",
    "@jest/globals": "^30.1.2",
    "check-export-map": "^1.3.1",
    "eslint": "^9.39.4",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "tsup": "^8.1.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
